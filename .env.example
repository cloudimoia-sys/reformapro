# Copia este archivo a .env (local) o .env en el servidor y rellena los valores reales.
# Nunca subas el .env real a git.

# --- Solo desarrollo local (npm run dev + docker-compose.dev.yml) ---
# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://reformapro:reformapro@localhost:5432/reformapro?schema=public"
# En local, la directa es la misma que la normal (no hay pooling que gestionar).
DIRECT_URL="postgresql://reformapro:reformapro@localhost:5432/reformapro?schema=public"

# --- Solo Vercel + Neon (despliegue gratis) ---
# Neon te da DOS cadenas de conexión distintas al crear el proyecto:
# DATABASE_URL = la que pone "-pooler" en el host (para la app en producción)
# DIRECT_URL   = la que NO lleva "-pooler" (solo para aplicar migraciones)
# Ambas van en las variables de entorno del proyecto en Vercel, no aquí.

# --- Solo producción (docker-compose.yml) ---
# Credenciales del contenedor de Postgres; docker-compose.yml arma el DATABASE_URL
# real automáticamente con estos valores (host "db" dentro de la red de Docker).
POSTGRES_USER="reformapro"
POSTGRES_PASSWORD="cambia-esto-por-una-contraseña-fuerte"
POSTGRES_DB="reformapro"

# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-aleatorio"

# URL pública de la app (en producción: https://tudominio.es)
NEXTAUTH_URL="http://localhost:3000"

# Clave de la API de Gemini (aistudio.google.com/apikey) — solo se usa en el backend,
# el navegador nunca la ve.
#
# OJO con la capa gratuita: el cupo es POR MODELO y POR PROYECTO, así que lo
# comparten todas las empresas dadas de alta en la app. Si el asistente empieza a
# fallar de golpe, mira si es un 429 por cupo agotado antes de buscar el fallo en
# el código. Con facturación activada en Google AI Studio desaparece el tope; el
# coste por presupuesto es de céntimos.
GEMINI_API_KEY="pon-aqui-tu-clave"

# Opcional: modelo de Gemini. Por defecto gemini-3.5-flash-lite, fijado a
# propósito. NO uses un alias "-latest": apunta al modelo más nuevo, y los recién
# salidos traen el cupo gratuito más estrecho (gemini-3.6-flash da 20 peticiones
# al día para todo el proyecto). Fijar la versión evita que el cupo cambie solo
# cuando Google publica un modelo nuevo.
# GEMINI_MODEL="gemini-3.5-flash-lite"

# --- Alta de nuevas empresas ---
# Mientras esta variable tenga valor, el registro pide ese código de invitación.
# Bórrala (o déjala vacía) para abrir el registro a cualquiera.
REGISTRO_CODIGO="cambia-esto-o-borralo-para-abrir-el-registro"

# --- Email (recuperar contraseña) ---
# Elige UNO. Si no pones ninguno, los correos se escriben por consola en vez de
# enviarse, que para desarrollo va bien.
#
# Brevo: recomendado si NO tienes dominio propio — permite verificar una sola
# dirección remitente (tu Gmail). https://app.brevo.com
BREVO_API_KEY=""
# Resend: exige verificar un DOMINIO entero, así que solo sirve si compras uno.
# Con el subdominio .vercel.app no se puede. https://resend.com
RESEND_API_KEY=""

# Dirección desde la que salen los correos (tiene que estar verificada arriba).
EMAIL_REMITENTE="tu-correo@gmail.com"
EMAIL_REMITENTE_NOMBRE="ReformaPro"

# Dominio para Caddy (solo producción, ver Caddyfile)
DOMAIN="tudominio.es"
