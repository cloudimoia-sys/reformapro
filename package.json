{
  "name": "reformapro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-tenant-scope.mjs && node scripts/check-csp.mjs && node scripts/check-escape.mjs && node scripts/migrar.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test:aislamiento": "tsx scripts/verificar-aislamiento.ts",
    "postinstall": "prisma generate",
    "test:catalogo": "tsx scripts/verificar-catalogo.ts",
    "test:precios": "tsx scripts/verificar-precios.ts",
    "test:sobrantes": "tsx scripts/verificar-sobrantes.ts",
    "test:completitud": "tsx scripts/verificar-completitud.ts",
    "test:diagnostico": "tsx scripts/verificar-diagnostico.ts",
    "test:planificacion": "tsx scripts/verificar-planificacion.ts",
    "test:suscripcion": "tsx scripts/verificar-suscripcion.ts",
    "test:facturacion": "tsx scripts/verificar-facturacion.ts",
    "test:presupuestos": "npm run test:catalogo && npm run test:precios && npm run test:sobrantes && npm run test:completitud",
    "test:todo": "npm run test:presupuestos && npm run test:diagnostico && npm run test:planificacion && npm run test:suscripcion && npm run test:facturacion && npm run test:energia && npm run test:texto",
    "test:energia": "tsx scripts/verificar-energia.ts",
    "test:texto": "tsx scripts/verificar-texto.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "next": "^16.2.12",
    "next-auth": "^4.24.15",
    "prisma": "^5.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
