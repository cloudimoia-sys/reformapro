generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" es el runtime de las funciones serverless de Vercel;
  // "native" mantiene el motor correcto para desarrollo local (Windows/Mac/Linux) y Docker.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" (con PgBouncer) que usa la app en cada petición — necesaria en
  // entornos serverless como Vercel, donde cada función abre su propia conexión.
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooling), solo para migraciones. En un VPS con Docker,
  // DIRECT_URL puede ser idéntica a DATABASE_URL sin problema.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
  FACTURADO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
}

/// Los dos informes tienen estructura distinta y no son intercambiables:
/// PATOLOGIAS es el informe técnico que entrega el reformista a su cliente, y
/// PERICIAL es el dictamen judicial, que lleva juramento del art. 335 LEC,
/// intervinientes, metodología y anexo de cálculo.
enum TipoInforme {
  PATOLOGIAS
  PERICIAL
}

enum EstadoInforme {
  BORRADOR
  FINALIZADO
}

enum PlanSuscripcion {
  PRUEBA
  BASICO
  PRO
}

enum EstadoSuscripcion {
  PRUEBA
  ACTIVA
  SUSPENDIDA
  CANCELADA
}

/// Raíz del tenant: cada empresa cliente de ReformaPro es una fila aquí, y TODOS los
/// demás registros cuelgan de ella vía `empresaId`. Borrar una empresa borra sus datos.
model Empresa {
  id            String            @id @default(cuid())
  nombre        String
  cif           String            @default("")
  direccion     String            @default("")
  tel           String            @default("")
  email         String
  ivaDefecto    Int               @default(10)
  /// Logo en base64 (data URL), opcional. Solo se muestra en las facturas si está puesto.
  logo          String?
  plan          PlanSuscripcion   @default(PRUEBA)
  estadoSusc    EstadoSuscripcion @default(PRUEBA)
  trialFinaliza DateTime?
  createdAt     DateTime          @default(now())

  usuarios     Usuario[]
  clientes     Cliente[]
  proveedores  Proveedor[]
  productos    Producto[]
  presupuestos Presupuesto[]
  lineas       LineaPresupuesto[]
  facturas     Factura[]
  counters     Counter[]
  informes     Informe[]
  informeFotos InformeFoto[]
}

model Usuario {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  /// Único a nivel global (no por empresa) para que el login no tenga que preguntar
  /// a qué empresa perteneces. Un email = una cuenta en toda la plataforma.
  email           String   @unique
  passwordHash    String
  rol             Rol      @default(EMPLEADO)
  emailVerificado Boolean  @default(false)
  createdAt       DateTime @default(now())

  tokensReset PasswordResetToken[]

  @@index([empresaId])
}

model Cliente {
  id           String        @id @default(cuid())
  empresaId    String
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  tel          String?
  email        String?
  direccion    String?
  nif          String?
  notas        String?
  createdAt    DateTime      @default(now())
  presupuestos Presupuesto[]
  facturas     Factura[]
  informes     Informe[]

  /// Necesario para que las claves foráneas compuestas de abajo puedan apuntar al par
  /// (id, empresaId) y así Postgres impida referenciar un cliente de otra empresa.
  @@unique([id, empresaId])
  @@index([empresaId])
}

model Proveedor {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  web       String?
  productos Producto[]

  @@unique([id, empresaId])
  @@index([empresaId])
}

model Producto {
  id        String    @id @default(cuid())
  empresaId String
  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  provId    String
  proveedor Proveedor @relation(fields: [provId, empresaId], references: [id, empresaId], onDelete: Cascade)
  nombre    String
  unidad    String
  precio    Float
  fecha     DateTime  @default(now())
  /// URL de la ficha del producto en la web del proveedor, para el botón "Comprobar precio".
  url       String?

  @@index([empresaId])
  @@index([provId, empresaId])
}

model Presupuesto {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa: cada empresa tiene su propia serie PRE-2026-001.
  numero    String
  clienteId String?
  /// NoAction (no SetNull): en una FK compuesta, SET NULL anularía también empresaId,
  /// que es NOT NULL. borrarCliente() desvincula explícitamente antes de borrar.
  cliente   Cliente? @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  titulo     String
  fecha      DateTime           @default(now())
  iva        Int                @default(10)
  estado     EstadoPresupuesto  @default(BORRADOR)
  notas      String?
  firma      String?
  fechaFirma DateTime?
  firmaIp    String?
  autor      String?
  createdAt  DateTime           @default(now())
  lineas     LineaPresupuesto[]
  facturas   Factura[]

  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId])
  @@index([clienteId, empresaId])
}

model LineaPresupuesto {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId, empresaId], references: [id, empresaId], onDelete: Cascade)
  capitulo      String?
  concepto      String
  descripcion   String?
  cantidad      Float
  unidad        String
  precio        Float
  /// Descuento en % (0-100) aplicado sobre esta línea (material, mano de obra, lo que sea).
  descuento     Float       @default(0)
  orden         Int         @default(0)

  @@index([empresaId])
  @@index([presupuestoId, empresaId])
}

model Factura {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa. Sin huecos: lo exige la normativa española.
  numero        String
  presupuestoId String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  fecha  DateTime      @default(now())
  base   Float
  iva    Int
  total  Float
  estado EstadoFactura @default(PENDIENTE)

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([presupuestoId, empresaId])
  @@index([clienteId, empresaId])
}

/// Informe técnico o pericial sobre un inmueble.
///
/// Los apartados van en `contenido` como JSON en vez de en columnas: cada tipo de
/// informe tiene los suyos (el pericial lleva juramento, intervinientes y anexo de
/// cálculo; el de patologías no), y la lista crecerá conforme aparezcan modelos
/// nuevos. Con columnas fijas cada variante obligaría a una migración.
model Informe {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa: INF-2026-001.
  numero    String
  clienteId String?
  /// NoAction como en Presupuesto: en una FK compuesta, SET NULL anularía también
  /// empresaId, que es NOT NULL.
  cliente   Cliente? @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  tipo    TipoInforme
  titulo  String
  /// Dirección del inmueble objeto del informe.
  inmueble       String        @default("")
  refCatastral   String?
  /// Quien encarga el informe: puede no ser el cliente (una aseguradora, un juzgado).
  solicitante    String?
  /// Datos del técnico que firma. En un pericial judicial son obligatorios.
  perito         String?
  titulacion     String?
  colegiado      String?

  fecha     DateTime      @default(now())
  estado    EstadoInforme @default(BORRADOR)
  /// Apartados del informe tal y como los devolvió la IA y los editó el usuario.
  contenido Json
  autor     String?
  createdAt DateTime      @default(now())
  fotos     InformeFoto[]

  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId])
  @@index([clienteId, empresaId])
}

/// Foto de la inspección, guardada como data URL redimensionada en el navegador.
///
/// Va en la base de datos, igual que el logo de empresa, porque el plan gratuito
/// no incluye almacenamiento de archivos. El cliente las reduce antes de subirlas
/// para que un informe con diez fotos no ocupe decenas de megas.
model InformeFoto {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  informeId String
  informe   Informe @relation(fields: [informeId, empresaId], references: [id, empresaId], onDelete: Cascade)

  datos String
  /// Pie de foto: qué se ve y dónde. Es lo que la convierte en prueba.
  pie   String @default("")
  orden Int    @default(0)

  @@index([empresaId])
  @@index([informeId, empresaId])
}

/// Contador atómico para numerar presupuestos/facturas, uno por empresa y año.
model Counter {
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "presupuesto" o "factura".
  tipo      String
  anio      Int
  value     Int     @default(0)

  @@id([empresaId, tipo, anio])
}

/// Token de un solo uso para restablecer la contraseña. Se guarda solo el hash:
/// quien lea la base de datos no puede usar los tokens pendientes.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

/// Límite de altas por IP. En BD y no en memoria porque en Vercel cada función
/// serverless tiene su propia memoria y un contador local no serviría de nada.
model RegistroIntento {
  id        String   @id @default(cuid())
  /// SHA-256 de la IP + secreto: permite contar sin almacenar la IP en claro (RGPD).
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}
