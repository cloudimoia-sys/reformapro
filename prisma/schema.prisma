generator client {
  provider      = "prisma-client-js"
  // "rhel-openssl-3.0.x" es el runtime de las funciones serverless de Vercel;
  // "native" mantiene el motor correcto para desarrollo local (Windows/Mac/Linux) y Docker.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión "pooled" (con PgBouncer) que usa la app en cada petición — necesaria en
  // entornos serverless como Vercel, donde cada función abre su propia conexión.
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooling), solo para migraciones. En un VPS con Docker,
  // DIRECT_URL puede ser idéntica a DATABASE_URL sin problema.
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
}

enum EstadoPresupuesto {
  BORRADOR
  ENVIADO
  APROBADO
  RECHAZADO
  FACTURADO
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
}

/// Los dos informes tienen estructura distinta y no son intercambiables:
/// PATOLOGIAS es el informe técnico que entrega el reformista a su cliente, y
/// PERICIAL es el dictamen judicial, que lleva juramento del art. 335 LEC,
/// intervinientes, metodología y anexo de cálculo.
/// MATERIAL: algo que se compra a un proveedor, con su precio de tarifa.
/// PARTIDA: una unidad de obra propia ya tarifada por el reformista (cambiar un
/// plato de ducha, dejar un punto nuevo de agua), con mano de obra incluida.
enum TipoCatalogo {
  MATERIAL
  PARTIDA
}

/// Tipos de documento que sabe redactar la app. La plantilla de cada uno vive en
/// lib/documentos.ts; aquí solo está el valor que se guarda.
enum TipoInforme {
  PATOLOGIAS
  PERICIAL
  ACTA_VISITA
  ACTA_ENTREGA
  CERTIFICADO_OBRA
  MEMORIA_TECNICA
  PLAN_TRABAJO
  CERTIFICACION
  RECLAMACION
  CARTA_SEGURO
  SOLICITUD_AYUNTAMIENTO
  EVALUACION_ENERGETICA
}

enum EstadoInforme {
  BORRADOR
  FINALIZADO
}

enum EstadoObra {
  PLANIFICADA
  EN_CURSO
  PARADA
  TERMINADA
}

enum EstadoParte {
  BORRADOR
  FIRMADO
}

/// A qué se refiere una línea del parte: horas de un técnico o material puesto en obra.
/// Deliberadamente solo dos: el desplazamiento o cualquier otro concepto se anota
/// como una línea de MATERIAL más (con su unidad, "ud" o "km"), en vez de abrir un
/// tercer tipo que casi nunca se usaría distinto de los otros dos.
enum TipoLineaParte {
  MANO_OBRA
  MATERIAL
}

enum PlanSuscripcion {
  PRUEBA
  BASICO
  PRO
}

enum EstadoSuscripcion {
  PRUEBA
  ACTIVA
  SUSPENDIDA
  CANCELADA
}

/// Raíz del tenant: cada empresa cliente de ReformaPro es una fila aquí, y TODOS los
/// demás registros cuelgan de ella vía `empresaId`. Borrar una empresa borra sus datos.
model Empresa {
  id            String            @id @default(cuid())
  nombre        String
  cif           String            @default("")
  direccion     String            @default("")
  /// Los tres siguientes son obligatorios en Facturae: sin ellos el XML no valida
  /// y el programa de gestión del cliente rechaza la importación.
  codigoPostal  String            @default("")
  poblacion     String            @default("")
  provincia     String            @default("")
  tel           String            @default("")
  email         String
  ivaDefecto    Int               @default(10)
  /// Gastos generales y beneficio industrial en %, sobre la base del presupuesto.
  /// 0 = no se aplica ninguno, que es como funcionaba antes de existir el campo.
  margenDefecto Float             @default(0)
  /// Logo en base64 (data URL), opcional. Solo se muestra en las facturas si está puesto.
  logo          String?
  plan          PlanSuscripcion   @default(PRUEBA)
  estadoSusc    EstadoSuscripcion @default(PRUEBA)
  trialFinaliza DateTime?
  createdAt     DateTime          @default(now())

  usuarios     Usuario[]
  clientes     Cliente[]
  proveedores  Proveedor[]
  productos    Producto[]
  presupuestos Presupuesto[]
  lineas       LineaPresupuesto[]
  facturas     Factura[]
  counters     Counter[]
  informes     Informe[]
  informeFotos InformeFoto[]
  obras        Obra[]
  fases        Fase[]
  partesTrabajo      ParteTrabajo[]
  lineasParteTrabajo LineaParteTrabajo[]
  fotosParteTrabajo  FotoParteTrabajo[]
}

model Usuario {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  /// Único a nivel global (no por empresa) para que el login no tenga que preguntar
  /// a qué empresa perteneces. Un email = una cuenta en toda la plataforma.
  email           String   @unique
  passwordHash    String
  rol             Rol      @default(EMPLEADO)
  emailVerificado Boolean  @default(false)
  createdAt       DateTime @default(now())

  tokensReset PasswordResetToken[]

  @@index([empresaId])
}

model Cliente {
  id           String        @id @default(cuid())
  empresaId    String
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre       String
  tel          String?
  email        String?
  direccion    String?
  /// Necesarios para exportar a Facturae. Ver el comentario en Empresa.
  codigoPostal String        @default("")
  poblacion    String        @default("")
  provincia    String        @default("")
  nif          String?
  /// Código de este cliente en el ERP externo de la empresa (ExitERP u otro),
  /// para que un parte de trabajo se pueda casar con su ficha allí en vez de
  /// crear un cliente duplicado al importar. Se rellena a mano hasta que exista
  /// una integración real: ver el comentario de ParteTrabajo.codigoErp.
  codigoErp    String?
  notas        String?
  createdAt    DateTime      @default(now())
  presupuestos Presupuesto[]
  facturas     Factura[]
  informes     Informe[]
  obras        Obra[]
  partesTrabajo ParteTrabajo[]

  /// Necesario para que las claves foráneas compuestas de abajo puedan apuntar al par
  /// (id, empresaId) y así Postgres impida referenciar un cliente de otra empresa.
  @@unique([id, empresaId])
  @@index([empresaId])
}

model Proveedor {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombre    String
  web       String?
  productos Producto[]

  @@unique([id, empresaId])
  @@index([empresaId])
}

/// Entrada del catálogo de la empresa: un material que se compra, o una unidad de
/// obra propia ("cambiar plato de ducha", "punto nuevo de agua") con su precio ya
/// cerrado. Las partidas son lo que evita que la IA se invente precios de trabajos
/// que el reformista ya tiene tarifados.
model Producto {
  id        String     @id @default(cuid())
  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Opcional: una partida de mano de obra propia no tiene proveedor.
  provId    String?
  proveedor Proveedor? @relation(fields: [provId, empresaId], references: [id, empresaId], onDelete: Cascade)
  tipo      TipoCatalogo @default(MATERIAL)
  nombre    String
  /// Descripción técnica que se copia tal cual a la línea del presupuesto. En una
  /// partida es lo que el cliente lee, así que la escribe el reformista una vez y
  /// sale igual en todos sus presupuestos.
  descripcion String?
  /// Capítulo de obra al que pertenece la partida, para agrupar en el presupuesto.
  capitulo  String?
  unidad    String
  precio    Float
  fecha     DateTime   @default(now())
  /// URL de la ficha del producto en la web del proveedor, para el botón "Comprobar precio".
  url       String?

  @@index([empresaId])
  @@index([provId, empresaId])
  @@index([empresaId, tipo])
}

model Presupuesto {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa: cada empresa tiene su propia serie PRE-2026-001.
  numero    String
  clienteId String?
  /// NoAction (no SetNull): en una FK compuesta, SET NULL anularía también empresaId,
  /// que es NOT NULL. borrarCliente() desvincula explícitamente antes de borrar.
  cliente   Cliente? @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  titulo     String
  fecha      DateTime           @default(now())
  iva        Int                @default(10)
  /// Margen de este presupuesto en %. Se copia del de la empresa al crearlo, para
  /// poder subirlo o bajarlo en una obra concreta sin tocar la configuración.
  margen     Float              @default(0)
  estado     EstadoPresupuesto  @default(BORRADOR)
  notas      String?
  firma      String?
  fechaFirma DateTime?
  firmaIp    String?
  autor      String?
  createdAt  DateTime           @default(now())
  lineas     LineaPresupuesto[]
  facturas   Factura[]
  obras      Obra[]

  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId])
  @@index([clienteId, empresaId])
}

model LineaPresupuesto {
  id            String      @id @default(cuid())
  empresaId     String
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  presupuestoId String
  presupuesto   Presupuesto @relation(fields: [presupuestoId, empresaId], references: [id, empresaId], onDelete: Cascade)
  capitulo      String?
  concepto      String
  descripcion   String?
  cantidad      Float
  unidad        String
  precio        Float
  /// Descuento en % (0-100) aplicado sobre esta línea (material, mano de obra, lo que sea).
  descuento     Float       @default(0)
  orden         Int         @default(0)

  @@index([empresaId])
  @@index([presupuestoId, empresaId])
}

model Factura {
  id            String       @id @default(cuid())
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa. Sin huecos: lo exige la normativa española.
  numero        String
  presupuestoId String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)
  clienteId     String?
  cliente       Cliente?     @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  fecha  DateTime      @default(now())
  base   Float
  iva    Int
  total  Float
  estado EstadoFactura @default(PENDIENTE)

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([presupuestoId, empresaId])
  @@index([clienteId, empresaId])
}

/// Informe técnico o pericial sobre un inmueble.
///
/// Los apartados van en `contenido` como JSON en vez de en columnas: cada tipo de
/// informe tiene los suyos (el pericial lleva juramento, intervinientes y anexo de
/// cálculo; el de patologías no), y la lista crecerá conforme aparezcan modelos
/// nuevos. Con columnas fijas cada variante obligaría a una migración.
model Informe {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa: INF-2026-001.
  numero    String
  clienteId String?
  /// NoAction como en Presupuesto: en una FK compuesta, SET NULL anularía también
  /// empresaId, que es NOT NULL.
  cliente   Cliente? @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  tipo    TipoInforme
  titulo  String
  /// Dirección del inmueble objeto del informe.
  inmueble       String        @default("")
  refCatastral   String?
  /// Quien encarga el informe: puede no ser el cliente (una aseguradora, un juzgado).
  solicitante    String?
  /// Datos del técnico que firma. En un pericial judicial son obligatorios.
  perito         String?
  titulacion     String?
  colegiado      String?

  fecha     DateTime      @default(now())
  estado    EstadoInforme @default(BORRADOR)
  /// Apartados del informe tal y como los devolvió la IA y los editó el usuario.
  contenido Json
  autor     String?
  createdAt DateTime      @default(now())
  fotos     InformeFoto[]

  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId])
  @@index([clienteId, empresaId])
}

/// Foto de la inspección, guardada como data URL redimensionada en el navegador.
///
/// Va en la base de datos, igual que el logo de empresa, porque el plan gratuito
/// no incluye almacenamiento de archivos. El cliente las reduce antes de subirlas
/// para que un informe con diez fotos no ocupe decenas de megas.
model InformeFoto {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  informeId String
  informe   Informe @relation(fields: [informeId, empresaId], references: [id, empresaId], onDelete: Cascade)

  datos String
  /// Pie de foto: qué se ve y dónde. Es lo que la convierte en prueba.
  pie   String @default("")
  orden Int    @default(0)

  @@index([empresaId])
  @@index([informeId, empresaId])
}

/// Obra en ejecución y su planificación.
///
/// Las fechas de cada fase NO se guardan: se calculan con lib/planificacion.ts a
/// partir de la duración, las dependencias y el calendario laboral. Guardarlas
/// sería duplicar la verdad, y en cuanto alguien moviera el inicio de la obra
/// quedarían fechas viejas por la base de datos sin que nadie se enterase.
model Obra {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  nombre    String
  direccion String  @default("")
  clienteId String?
  /// NoAction como en Presupuesto e Informe: en una FK compuesta, SET NULL
  /// anularía también empresaId, que es NOT NULL.
  cliente   Cliente? @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  /// Presupuesto del que salieron las fases, si se creó a partir de uno.
  presupuestoId String?
  presupuesto   Presupuesto? @relation(fields: [presupuestoId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  inicio DateTime
  estado EstadoObra @default(PLANIFICADA)

  /// Festivos autonómicos, locales y cierres de la empresa, en AAAA-MM-DD
  /// separados por coma. Los nacionales los pone el programa.
  festivosPropios String  @default("")
  sabadosSeTrabaja Boolean @default(false)

  /// Secreto del feed de calendario. Quien tiene la URL ve la obra, así que se
  /// genera aleatorio y se puede regenerar para cortar el acceso.
  tokenCalendario String @unique

  notas     String   @default("")
  createdAt DateTime @default(now())
  fases     Fase[]
  partesTrabajo ParteTrabajo[]

  @@unique([id, empresaId])
  @@index([empresaId])
  @@index([clienteId, empresaId])
}

/// Fase de obra. La duración va en días de TRABAJO y la espera en días de
/// CALENDARIO: el hormigón fragua también en domingo.
model Fase {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  obraId    String
  obra      Obra    @relation(fields: [obraId, empresaId], references: [id, empresaId], onDelete: Cascade)

  orden  Int    @default(0)
  nombre String
  oficio String @default("")
  /// Días de trabajo efectivo.
  dias   Int    @default(1)
  /// Días naturales de espera obligada al terminar (fraguado, secado, curado).
  esperaDias Int @default(0)
  /// Id de la fase que debe terminar antes. Vacío = arranca con la obra.
  dependeDe String @default("")
  /// Punto de control: hay que comprobar o decidir algo antes de seguir.
  hito      Boolean @default(false)
  notas     String  @default("")

  @@index([empresaId])
  @@index([obraId, empresaId])
}

/// Contador atómico para numerar presupuestos/facturas, uno por empresa y año.
model Counter {
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// "presupuesto" o "factura".
  tipo      String
  anio      Int
  value     Int     @default(0)

  @@id([empresaId, tipo, anio])
}

/// Token de un solo uso para restablecer la contraseña. Se guarda solo el hash:
/// quien lea la base de datos no puede usar los tokens pendientes.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime
  usadoEn   DateTime?
  createdAt DateTime  @default(now())

  @@index([usuarioId])
}

/// Intentos contados para limitar abuso: altas, inicios de sesión fallidos y
/// llamadas a la IA.
///
/// En base de datos y no en memoria porque en Vercel cada función serverless
/// tiene su propia memoria: un contador local no contaría casi nada, y bastaría
/// con repartir los intentos entre instancias para saltárselo.
///
/// La tabla sigue llamándose RegistroIntento en Postgres (@@map) para no tener
/// que renombrarla en producción; el modelo se llama Intento porque ya no cuenta
/// solo registros.
model Intento {
  id        String   @id @default(cuid())
  /// Qué se está contando: "registro", "login", "ia".
  tipo      String   @default("registro")
  /// SHA-256 de la IP —o del email— más un secreto: permite contar sin guardar
  /// el dato en claro (RGPD).
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
  @@index([tipo, ipHash, createdAt])
  @@map("RegistroIntento")
}

/// Parte de trabajo: lo que un técnico rellena tras una visita, con las horas
/// que ha echado, el trabajo hecho y el material que ha puesto. No es un
/// presupuesto —eso se estima antes— ni una factura —eso la emite el programa
/// del cliente—: es el registro de lo que de verdad ha pasado en la obra.
model ParteTrabajo {
  id        String  @id @default(cuid())
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Correlativo por empresa: cada empresa tiene su propia serie PT-2026-001.
  numero    String

  /// Código de este parte en el ERP externo (ExitERP u otro), para poder
  /// casarlo con su ficha allí cuando se traspase.
  ///
  /// NO HAY INTEGRACIÓN EN VIVO CON NINGÚN ERP: ExitERP no publica una API con
  /// la que esta aplicación pueda hablar, y sin sus documentos o su cooperación
  /// no hay nada real que construir ahí — inventar una integración que no se
  /// puede probar sería peor que no tener ninguna. Lo que SÍ hay es un puente
  /// que funciona hoy: este campo se rellena a mano (o se deja vacío y se
  /// asigna después) y la exportación a Excel lo saca en su propia columna,
  /// lista para lo que ExitERP sepa importar. Es la misma solución que ya se
  /// tomó con la facturación: un Excel que cualquiera sabe abrir vale más que
  /// una integración a medias con un formato que nadie ha podido verificar.
  codigoErp String?

  clienteId String?
  /// NoAction como en Presupuesto e Informe: en una FK compuesta, SET NULL
  /// anularía también empresaId, que es NOT NULL.
  cliente   Cliente? @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  /// Obra a la que pertenece, si la hay. Un aviso suelto de mantenimiento no
  /// tiene por qué estar planificado como obra.
  obraId String?
  obra   Obra? @relation(fields: [obraId, empresaId], references: [id, empresaId], onDelete: NoAction, onUpdate: NoAction)

  titulo     String
  direccion  String   @default("")
  fecha      DateTime @default(now())
  /// "09:00" / "13:30". Es lo que el cliente ve y firma —a qué hora vino el
  /// técnico—, y va aparte de las horas de las líneas de mano de obra, que son
  /// las que de verdad se valoran (pueden ser varios técnicos con horarios
  /// distintos el mismo parte).
  horaInicio String?
  horaFin    String?

  /// Quien ha hecho el trabajo. Texto libre y no una relación a Usuario: un
  /// parte lo puede firmar un autónomo subcontratado que no tiene cuenta en la
  /// aplicación, igual que el "perito" de un informe.
  tecnico String @default("")
  /// Quien lo ha creado en la aplicación, que no siempre es el mismo técnico
  /// (la oficina puede rellenar el parte que le ha dictado por teléfono).
  autor   String?

  descripcion   String @default("")
  observaciones String @default("")

  firma      String?
  fechaFirma DateTime?
  firmaIp    String?

  estado    EstadoParte @default(BORRADOR)
  createdAt DateTime    @default(now())

  lineas LineaParteTrabajo[]
  fotos  FotoParteTrabajo[]

  @@unique([empresaId, numero])
  @@unique([id, empresaId])
  @@index([empresaId])
  @@index([clienteId, empresaId])
  @@index([obraId, empresaId])
}

model LineaParteTrabajo {
  id        String       @id @default(cuid())
  empresaId String
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parteId   String
  parte     ParteTrabajo @relation(fields: [parteId, empresaId], references: [id, empresaId], onDelete: Cascade)

  tipo TipoLineaParte @default(MATERIAL)

  concepto    String
  descripcion String?
  /// En una línea de MANO_OBRA son las horas; en una de MATERIAL, las unidades.
  cantidad    Float
  unidad      String
  precio      Float
  orden       Int    @default(0)

  @@index([empresaId])
  @@index([parteId, empresaId])
}

model FotoParteTrabajo {
  id        String       @id @default(cuid())
  empresaId String
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parteId   String
  parte     ParteTrabajo @relation(fields: [parteId, empresaId], references: [id, empresaId], onDelete: Cascade)

  datos String
  pie   String @default("")
  orden Int    @default(0)

  @@index([empresaId])
  @@index([parteId, empresaId])
}
